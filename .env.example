# ---- Required ----
DOMAIN=qa.yourcompany.com              # A record → droplet IP
PUBLIC_APP_URL=https://qa.yourcompany.com
MONGO_PASSWORD=change-me-strong        # used by the bundled MongoDB container
JWT_SECRET=change-me-long-random       # openssl rand -hex 32
ENCRYPTION_KEY=                        # openssl rand -base64 32   (never change after first use!)
ANTHROPIC_API_KEY=sk-ant-...

# ---- Database ----
# Leave MONGODB_URI empty to use the bundled MongoDB container.
# For DigitalOcean Managed MongoDB / Atlas, paste the connection string here:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongo.ondigitalocean.com/qapilot?tls=true&authSource=admin
MONGODB_URI=

# ---- Optional ----
CLAUDE_MODEL=claude-sonnet-5-5         # AI tester + API case generation
CLAUDE_MODEL_STRONG=claude-opus-5-5    # Figma vision review, AI eval judge, report summary
COOKIE_SECURE=true                     # keep true behind HTTPS
ALLOW_REGISTRATION=false               # first user can always sign up; then add people from Team
WORKER_CONCURRENCY=2                   # parallel QA runs per worker
AGENT_MAX_STEPS=25                     # AI tester actions per module
VISUAL_DIFF_THRESHOLD=0.5              # % pixel difference tolerated vs Figma
API_LATENCY_MS=2000
AI_LATENCY_P95_MS=15000
SCHEDULE_TZ=Asia/Karachi
